# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# Ne commitez JAMAIS .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (génération et édition des sites)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
# Modèles de repli, séparés par des virgules (optionnel)
GEMINI_TEXT_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest

# OpenRouter (images des visuels marketing)
OPENROUTER_API_KEY=

# Domaine racine des sites publiés (voir src/proxy.ts). Laisser vide tant
# qu'aucun nom de domaine n'est branché : les sites restent servis par
# chemin (/s/<slug>). En local, pour tester les sous-domaines :
# NEXT_PUBLIC_DOMAINE_RACINE=localhost:3000
NEXT_PUBLIC_DOMAINE_RACINE=
